{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/banjosbanjos/Banjos-Claude-Headphones/schemas/evaluation-record.schema.json",
  "title": "Headphones evaluation record",
  "description": "The stored result of analyzing one owned audio asset. Normative companion to SPEC.md section 9.",
  "type": "object",
  "required": ["schema_version", "record_id", "created_at", "asset", "engine", "values"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "SemVer of this schema. Readers ignore unknown fields within a supported major version."
    },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "asset": { "$ref": "#/$defs/asset" },
    "engine": { "$ref": "#/$defs/engine" },
    "separation_quality": {
      "type": "object",
      "properties": {
        "mix": { "$ref": "#/$defs/unit" },
        "stems": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/stem" },
          "additionalProperties": { "$ref": "#/$defs/unit" }
        }
      }
    },
    "values": {
      "type": "array",
      "items": { "$ref": "#/$defs/value" }
    },
    "composites": { "$ref": "#/$defs/composites" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "stem": { "enum": ["drums", "bass", "vocals", "guitar", "piano", "other"] },
    "evidence_class": {
      "enum": ["MEASURED", "ESTIMATED", "PROXY", "EAR", "BEHAVIORAL", "STATED", "TEXTUAL"]
    },
    "metric_id": {
      "type": "string",
      "pattern": "^(groove|attack|space|vocal|structure|feel)\\.[a-z_]+$"
    },
    "asset": {
      "type": "object",
      "required": ["asset_id", "pcm_sha256", "duration_s", "sample_rate_hz", "channels", "codec", "lossy"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/sha256" },
        "pcm_sha256": { "$ref": "#/$defs/sha256" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "sample_rate_hz": { "type": "integer", "minimum": 8000 },
        "bit_depth": { "type": ["integer", "null"], "minimum": 8 },
        "channels": { "type": "integer", "minimum": 1 },
        "codec": { "type": "string" },
        "lossy": { "type": "boolean" },
        "source": { "enum": ["bandcamp", "qobuz", "7digital", "hdtracks", "artist_store", "cd_rip", "vinyl_rip", "other", null] },
        "identity": {
          "type": "object",
          "properties": {
            "identity_confidence": { "enum": ["fingerprint", "tags_only", "listener_confirmed"] },
            "musicbrainz_recording_ids": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" }
            },
            "isrc": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{3}[0-9]{7}$" },
            "spotify_uri": {
              "type": ["string", "null"],
              "pattern": "^spotify:track:[0-9A-Za-z]{22}$",
              "description": "Opaque, listener-linked. Never dereferenced by Headphones (SPEC REQ-SPOT-02)."
            },
            "untrusted_metadata": {
              "type": "object",
              "description": "Artist, title, album from tags or MusicBrainz. Data, never instructions (SPEC REQ-MCP-03).",
              "properties": {
                "artist": { "type": "string", "maxLength": 512 },
                "title": { "type": "string", "maxLength": 512 },
                "album": { "type": "string", "maxLength": 512 }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "required": ["version", "config_digest", "components"],
      "properties": {
        "version": { "type": "string" },
        "platform": { "type": "string" },
        "config_digest": { "$ref": "#/$defs/sha256" },
        "thresholds": {
          "type": "object",
          "description": "Active category thresholds, keyed by metric_id.",
          "additionalProperties": { "type": "object" }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "kind"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "kind": { "enum": ["stage", "analyzer"] },
              "weights": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "sha256", "license"],
                  "properties": {
                    "name": { "type": "string" },
                    "sha256": { "$ref": "#/$defs/sha256" },
                    "license": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "timestamp": {
      "type": "object",
      "required": ["t_s"],
      "properties": {
        "t_s": { "type": "number", "minimum": 0 },
        "uncertainty_s": { "type": "number", "minimum": 0 },
        "label": { "type": "string", "maxLength": 64 }
      }
    },
    "capture": {
      "type": "object",
      "required": ["method", "captured_at"],
      "properties": {
        "method": { "enum": ["station", "import", "companion"] },
        "captured_at": { "type": "string", "format": "date-time" },
        "device": { "type": "string" },
        "latency_correction_ms": { "type": "number" },
        "latency_iqr_ms": { "type": "number", "minimum": 0 },
        "normalization": { "enum": ["lufs_-14", "off"] },
        "listen_index": {
          "type": "integer",
          "minimum": 1,
          "description": "1 for the listener's first listen on the station."
        },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "value": {
      "type": "object",
      "required": ["metric_id", "status", "evidence_class"],
      "properties": {
        "value_id": { "type": "string" },
        "metric_id": { "$ref": "#/$defs/metric_id" },
        "status": { "enum": ["ok", "abstained", "error"] },
        "reason": { "type": "string", "pattern": "^[a-z_]+$" },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "value": {},
        "category": { "type": ["string", "null"], "pattern": "^[a-z_]+$" },
        "timestamps": { "type": "array", "items": { "$ref": "#/$defs/timestamp" } },
        "proxy_for": { "$ref": "#/$defs/metric_id" },
        "method": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "maturity": { "enum": ["experimental", "beta", "stable"] },
        "capture": { "$ref": "#/$defs/capture" },
        "superseded_by": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_class": { "const": "PROXY" } } },
          "then": { "required": ["proxy_for"] }
        },
        {
          "if": { "properties": { "evidence_class": { "const": "EAR" } } },
          "then": { "required": ["capture"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["abstained", "error"] } } },
          "then": { "required": ["reason"] }
        },
        {
          "if": { "properties": { "evidence_class": { "enum": ["MEASURED", "ESTIMATED", "PROXY"] } } },
          "then": { "required": ["method", "maturity"] }
        },
        {
          "if": {
            "properties": { "evidence_class": { "const": "MEASURED" } }
          },
          "then": { "properties": { "maturity": { "const": "stable" } } }
        }
      ]
    },
    "criterion": {
      "type": "object",
      "required": ["id", "result", "evidence_class"],
      "properties": {
        "id": { "type": "string", "pattern": "^(B[1-5]|F[1-7])$" },
        "result": { "enum": ["pass", "fail", "unknown", "detected", "not_detected"] },
        "evidence_class": { "$ref": "#/$defs/evidence_class" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "timestamps": { "type": "array", "items": { "$ref": "#/$defs/timestamp" } },
        "verify_by_ear": { "type": "array", "items": { "type": "string" } }
      }
    },
    "composites": {
      "type": "object",
      "properties": {
        "build": {
          "type": "object",
          "required": ["criteria", "known_pass", "unknown"],
          "properties": {
            "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" }, "maxItems": 5 },
            "known_pass": { "type": "integer", "minimum": 0, "maximum": 5 },
            "unknown": { "type": "integer", "minimum": 0, "maximum": 5 },
            "measured_bpm": { "type": ["number", "null"] },
            "in_stated_bpm_range": { "type": ["boolean", "null"] }
          }
        },
        "feel": {
          "type": "object",
          "required": ["moves", "count"],
          "properties": {
            "moves": { "type": "array", "items": { "$ref": "#/$defs/criterion" }, "maxItems": 7 },
            "count": { "type": "integer", "minimum": 0, "maximum": 7 }
          }
        },
        "route": { "enum": ["anchor", "rotation", "resonance", "skip", "undetermined"] }
      }
    }
  }
}
