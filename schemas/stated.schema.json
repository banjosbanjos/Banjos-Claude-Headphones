{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/banjosbanjos/Banjos-Claude-Headphones/schemas/stated.schema.json",
  "$comment": "Schema version 0.2.0. SPEC REQ-EVID-04.",
  "title": "Stated preference",
  "description": "Something the listener said about their taste, stored verbatim. Never rewritten into a rule.",
  "type": "object",
  "required": ["schema_version", "stated_id", "text", "said_at", "context", "entered_at"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stated_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "The listener's exact words." },
    "said_at": { "type": "string", "format": "date" },
    "context": { "type": "string", "maxLength": 500, "description": "Where and why it was said, in the listener's words where possible." },
    "related_metrics": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(groove|attack|space|vocal|structure|feel)\\.[a-z_]+$" }
    },
    "entered_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "retracted_at": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" }
  },
  "additionalProperties": false
}
